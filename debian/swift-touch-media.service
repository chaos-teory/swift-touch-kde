[Unit]
Description=Swift Touch KDE media key daemon
After=graphical-session.target
Wants=graphical-session.target
ConditionPathExists=/dev/hidraw0

[Service]
Type=simple
ExecStart=/usr/bin/swift-touch-kde run-media-keys --dev /dev/hidraw0 --seconds 0 --emit uinput --require-active
Restart=on-failure
RestartSec=1
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
